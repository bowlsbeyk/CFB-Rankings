  "downstream_spec": "revised for the scored holdout; rated for the voter-bias test and swap re-run (DEVIATIONS.md, 2026-10-23)",
  "models": {
    "baseline": "predict 0 change",
    "linear": "sklearn LinearRegression, default settings",
    "gbt": {
      "class": "sklearn HistGradientBoostingRegressor",
      "params": {
        "max_iter": 300,
        "learning_rate": 0.05,
        "random_state": 0
      }
    }
  },
  "selection_rule": "Use linear unless gbt holdout MAE < 0.9 x linear holdout MAE. Applied once, per spec and treatment, when the holdout is scored.",
  "pass_criteria": "Chosen model beats baseline on holdout MAE, and its replayed final regular-season top 25 has Spearman >= 0.7 with the real 2024 and 2025 polls (definition in DEVIATIONS.md).",
  "collinearity_note": "margin = points_for - points_against, home + away + neutral = wins + losses = games, bye = (games == 0). Predictions are unaffected; individual linear coefficients within these groups are not separately identifiable."
